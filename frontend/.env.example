# Names and non-secret defaults only. Copy to .env.local for local work.

# Server side only, read by next.config.ts: the origin that /api/* is forwarded to.
# Unset means http://localhost:8000 in development and no rewrite in a production build.
BACKEND_ORIGIN=http://localhost:8000

# Public, inlined at build time. mock = synthetic data, no backend; live = same-origin /api/*.
# Unset means mock in development and live otherwise.
NEXT_PUBLIC_API_MODE=mock

# Public, inlined at build time (UA-16). Must equal the backend TERMS_VERSION.
NEXT_PUBLIC_TERMS_VERSION=2026-10-04
