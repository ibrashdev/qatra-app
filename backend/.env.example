# Qatra backend configuration. NAMES ONLY: copy to .env (gitignored) for local development
# and fill values there. Never commit values. In production the variables come from the
# Render environment and no .env file is read. Contract: docs/Implementation-contract.md §8.

# production | development | test (default: development)
APP_ENV=
# Exact frontend origin allowed on mutations, e.g. scheme://host[:port] with no path (required everywhere)
FRONTEND_ORIGIN=
# Supabase project URL (required in production)
SUPABASE_URL=
# Supabase publishable (anon) key (required in production)
SUPABASE_ANON_KEY=
# Supabase service_role key: Auth Admin API and content publishing only (secret; required in production)
SUPABASE_SERVICE_ROLE_KEY=
# Connection string of the separate limited database role qatra_server (secret; required in production)
QATRA_SERVER_DB=
# AES-256-GCM key that encrypts stored provider tokens (secret; required in production)
QATRA_SESSION_KEY=
# HMAC key for session token fingerprints: 32 random bytes, base64 (secret; required in production)
QATRA_SESSION_HMAC_KEY=
# HMAC key for recovery codes: 32 random bytes, base64 (secret; required in production)
QATRA_RECOVERY_HMAC_KEY=
# HMAC key for throttle keys: 32 random bytes, base64 (secret; required in production)
QATRA_THROTTLE_HMAC_KEY=
# Current terms version, e.g. a date (required everywhere)
TERMS_VERSION=
# OpenRouter API key for free-model requests (optional; the rules engine is the fallback)
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model candidates; only models with zero live pricing are used (optional)
OPENROUTER_MODELS=
# supabase | memory (default: supabase); memory is refused when APP_ENV=production
QATRA_DATA_BACKEND=
# Memory mode only: comma-separated content bundle paths (optional)
QATRA_CONTENT_BUNDLES=
# Version string reported by GET /api/health (optional; default: dev; source set at provisioning, O-08)
APP_VERSION=
# Readiness probe limit per client IP per minute (optional; default: 6)
QATRA_READY_RATE_PER_MIN=
# Maximum request body size in bytes (optional; default: 65536)
QATRA_BODY_LIMIT_BYTES=
# Public read class (E14): requests per client IP per minute (optional; default: 60)
QATRA_RATE_PUBLIC_READ_PER_MIN=
# Anonymous entry class (E03): requests per client IP per minute (optional; default: 10)
QATRA_RATE_ANONYMOUS_ENTRY_PER_MIN=
# Session read class (E11, E15): requests per client IP per minute (optional; default: 120)
QATRA_RATE_SESSION_READ_PER_MIN=
# Session write class (E05, E08-E10, E12, E13, E16, E17, E20, E30): requests per client IP per minute (optional; default: 60)
QATRA_RATE_SESSION_WRITE_PER_MIN=
# Chat write class (E31, E32, E34): requests per client IP per minute (optional; default: 20)
QATRA_RATE_CHAT_WRITE_PER_MIN=
# Proxies in front of the app that append to X-Forwarded-For (optional; default: 0 = use the peer address; N = the N-th entry from the right)
QATRA_TRUSTED_XFF_DEPTH=
# Plan conversation (D75), all optional. Model requests per day for the whole deployment (default: 50)
QATRA_OPENROUTER_FREE_REQUESTS_PER_DAY=
# Model requests per minute for the whole deployment (default: 20)
QATRA_OPENROUTER_FREE_REQUESTS_PER_MINUTE=
# Model calls per account per day (default: 10)
QATRA_CHAT_MODEL_CALLS_PER_ACCOUNT_PER_DAY=
# Model turns per conversation (default: 6)
QATRA_CHAT_MODEL_TURNS_PER_CHAT=
# Model timeout in seconds (default: 8)
QATRA_CHAT_MODEL_TIMEOUT_SEC=
# Maximum output tokens of a model reply (default: 400)
QATRA_CHAT_MAX_TOKENS=
# Version label of the input/output guard (default: guard-v1)
QATRA_CHAT_GUARD_VERSION=
# true | false (default: true): false makes every non-demo conversation rules-only (no model call)
QATRA_CHAT_MODEL_FOR_LEARNERS=
